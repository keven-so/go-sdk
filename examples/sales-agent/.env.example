# Copy to .env and fill in. Phase 0 dry-run needs NONE of these.
# Required only for `salesctl dry-run -live` and later phases.

# --- LLM (the agent brain) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_MAX_TURNS=16

# --- Data backbone (Phase 1+) ---
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, `salesctl serve` uses the
# Supabase-backed crm.Store (PostgREST); otherwise it uses the in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional table-name prefix. Leave empty for a dedicated database; set to e.g.
# "sa_" to namespace the tables inside a shared project's public schema.
SUPABASE_TABLE_PREFIX=
# or a direct Postgres connection string:
DATABASE_URL=

# --- Email: Gmail (Phase 2) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC=

# --- SMS + voice carrier: Twilio (Phase 3-4) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- AI voice platform (Phase 4) ---
VOICE_PLATFORM=vapi
VOICE_API_KEY=
VOICE_ASSISTANT_ID=
VOICE_FROM_NUMBER=

# --- Calendar (Phase 4) ---
GOOGLE_CALENDAR_ID=

# --- Webhooks / runtime ---
WEBHOOK_SIGNING_SECRET=
DRY_RUN=true
HTTP_ADDR=:8080
LOG_LEVEL=info
